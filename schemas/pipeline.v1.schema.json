{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relayai.local/schemas/pipeline.v1.schema.json",
  "title": "RelayAI PipelineDefinition v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "transcription", "destinations"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "activation": { "enum": ["push_to_talk", "toggle"] },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "transcription": { "$ref": "#/$defs/adapterRef" },
    "context": {
      "type": "array",
      "items": { "$ref": "#/$defs/adapterRef" }
    },
    "refinement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "adapter": { "$ref": "#/$defs/adapterRef" },
        "prompt_id": { "type": "string", "minLength": 1 }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "local_only": { "type": "boolean" },
        "confirm_network_destinations": { "type": "boolean" },
        "confirm_executable_destinations": { "type": "boolean" }
      }
    },
    "destinations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/destinationRef" }
    }
  },
  "$defs": {
    "adapterRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_id"],
      "properties": {
        "adapter_id": { "type": "string", "minLength": 1 },
        "settings": { "type": "object" },
        "credential_id": { "type": "string", "minLength": 1 }
      }
    },
    "destinationRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "adapter_id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "adapter_id": { "type": "string", "minLength": 1 },
        "settings": { "type": "object" },
        "credential_id": { "type": "string", "minLength": 1 }
      }
    }
  }
}
